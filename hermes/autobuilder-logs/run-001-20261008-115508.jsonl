focusIndex); event.accepted = true; break\\n94|        default: break\\n95|        }\\n96|    }\\n97|\\n98|    // --- Grid densities (Gallery / Standard) --------------------------------\\n99|    GridView {\\n100|        id: grid\\n101|        objectName: \\\"contentGrid\\\"\\n102|        anchors.fill: parent\\n103|        anchors.topMargin: contentView.pad\\n104|        anchors.bottomMargin: contentView.pad\\n105|        leftMargin: Math.max(contentView.pad,\\n106|                             (contentView.width\\n107|                              - (contentView.columns * contentView.cardWidth\\n108|                                 + (contentView.columns - 1) * contentView.gap)) / 2)\\n109|        rightMargin: leftMargin\\n110|        cellWidth: contentView.cardWidth + contentView.gap\\n111|        cellHeight: contentView.cellHeight + contentView.gap\\n112|        cacheBuffer: 400\\n113|        clip: true\\n114|        visible: !contentView.compact\\n115|        model: contentView.model\\n116|        focus: !contentView.compact\\n117|\\n118|        delegate: DelegateChooser {\\n119|            role: \\\"isFolder\\\"\\n120|\\n121|            DelegateChoice {\\n122|              ...", "duration_ms": 11, "is_error": false, "timestamp": 1791453364419}
