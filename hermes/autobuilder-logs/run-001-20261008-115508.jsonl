ate(path)\\n104|                        }\\n105|                    }\\n106|                    onVolumeEjectRequested: function (volumeId) {\\n107|                        if (window.mounts) {\\n108|                            window.mounts.eject(volumeId)\\n109|                        }\\n110|                    }\\n111|                }\\n112|            }\\n113|\\n114|            Rectangle {\\n115|                objectName: \\\"contentSurfaceRegion\\\"\\n116|                Layout.fillWidth: true\\n117|                Layout.fillHeight: true\\n118|                color: Theme.surface0\\n119|\\n120|                ContentView {\\n121|                    id: contentView\\n122|                    anchors.fill: parent\\n123|                    model: window.folderModel\\n124|                    onActivatedItem: function (index, path, isFolder) {\\n125|                        if (isFolder && window.browserController) {\\n126|                            window.browserController.navigate(path)\\n127|                        }\\n128|                    }\\n129|                }\\n130|            }\\n131|\\n132|            Rectangle {\\n133|                objectName: \\\"reelRegion\\\"\\n134|                Layo...", "duration_ms": 11, "is_error": false, "timestamp": 1791453351978}
