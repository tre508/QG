{"type": "tool_use", "name": "write_file", "input": {"content": "import QtQuick\nimport QtQuick.Controls\nimport QtQuick.Layouts\n\nimport qg\n\n// Status strip (DESIGN.md §3.2, §11.4, §12): the bottom row that answers\n// \"what's selected, is anything busy, did something just happen.\"\n//\n// Presentation only — every value is injected by C++ controllers/services (or\n// the shell's own view state); the strip performs no filesystem, database, or\n// other blocking work. Selection aggregation/identity, volume statistics and\n// background-task reporting are owned upstream (FolderModel/SelectionState,\n// the volume service, and the worker pools respectively); this component only\n// renders what it is given.\n//\n// Object names are a test/automation contract:\n//   statusStrip, statusSelection, statusFreeSpace, statusTransient,\n//   statusActivity, statusActivityCount, statusActivityPopover, statusTaskRow.\n\nRectangle {\n    id: strip\n\n    objectName: \"statusStrip\"\n\n    // Selection summary (aggregate of the current selection).\n    property int selectedCount: 0\n    property real selectedBytes: 0\n\n    // Current volume free space. Negative means \"unknown\" and is rendered\n    // without a fake number (DESIGN.md §12: the wording never lies).\n    property string volumeLabel: \"\"\n    property real volumeFreeBytes: -1\n\n    // Background activity: running task count + a list of {label, count} rows\n    // for the popover. Bounded by the worker infrastructure upstream.\n    property int busyCount: 0\n    property var tasks: []\n\n    // Transient status (toasts land in P64).\n    property string transientMessage: \"\"\n    property int transientKind: 0 // 0 info, 1 warn, 2 error\n\n    signal tasksActivated()\n\n    readonly property bool hasSelection: selectedCount > 0\n    readonly property bool freeSpaceKnown: volumeFreeBytes >= 0\n    readonly property bool activityVisible: busyCount > 0\n\n    implicitHeight: 28\n    color: Theme.surface1\n\n    function selectionText() {\n        if (!hasSelection)\n            return qsTr(\"No selection\")\n        return strip.selectedCount + qsTr(\" selected\") + \" · \" + Format.size(strip.selectedBytes)\n    }\n\n    function freeSpaceText() {\n        if (!freeSpaceKnown)\n            return \"\"\n        const label = strip.volumeLabel.length > 0 ? (\" \" + qsTr(\"on\") + \" \" + strip.volumeLabel) : \"\"\n        return qsTr(\"Free\") + \" \" + Format.size(strip.volumeFreeBytes) + label\n    }\n\n    function activityText() {\n        if (!activityVisible)\n            return \"\"\n        if (strip.busyCount === 1)\n            return qsTr(\"1 background task\")\n        return strip.busyCount + qsTr(\" background tasks\")\n    }\n\n    function transientColor() {\n        switch (strip.transientKind) {\n        case 1: return Theme.warn\n        case 2: return Theme.danger\n        default: return Theme.textMid\n        }\n    }\n\n    RowLayout {\n        anchors.fill: parent\n        anchors.leftMargin: Theme.space3\n        anchors.rightMargin: Theme.space3\n        spacing: Theme.space4\n\n        Text {\n            objectName: \"statusSelection\"\n            text: strip.selectionText()\n            color: strip.hasSelection ? Theme.textHi : Theme.textLow\n            font.pixelSize: Theme.fontMeta\n            elide: Text.ElideRight\n        }\n\n        Text {\n            objectName: \"statusFreeSpace\"\n            visible: strip.freeSpaceKnown\n            text: strip.freeSpaceText()\n            color: Theme.textMid\n            font.pixelSize: Theme.fontMeta\n            elide: Text.ElideRight\n        }\n\n        Item { Layout.fillWidth: true }\n\n        Text {\n            objectName: \"statusTransient\"\n            visible: strip.transientMessage.length > 0\n            text: strip.transientMessage\n            color: strip.transientColor()\n            font.pixelSize: Theme.fontMeta\n            elide: Text.ElideRight\n            Layout.maximumWidth: strip.width * 0.4\n        }\n\n        RowLayout {\n            objectName: \"statusActivity\"\n            visible: strip.activityVisible\n            spacing: Theme.space2\n\n            Row {\n                objectName: \"activityDots\"\n                spacing: Theme.space1\n\n                Repeater {\n                    model: 3\n\n                    delegate: Rectangle {\n                        width: 6\n                        height: 6\n                        radius: Theme.radiusChip\n                        color: Theme.play\n                        opacity: 0.4\n                        anchors.verticalCenter: parent.verticalCenter\n\n                        SequentialAnimation on opacity {\n                            running: Theme.motionEnabled\n                            loops: Animation.Infinite\n                            PauseAnimation { duration: index * 160 }\n                            NumberAnimation { to: 1.0; duration: 400 }\n                            NumberAnimation { to: 0.4; duration: 400 }\n                            PauseAnimation { duration: (2 - index) * 160 }\n                        }\n                    }\n                }\n            }\n\n            Text {\n                objectName: \"statusActivityCount\"\n                text: strip.activityText()\n                color: Theme.textMid\n                font.pixelSize: Theme.fontMeta\n            }\n\n            MouseArea {\n                anchors.fill: parent\n                acceptedButtons: Qt.LeftButton\n                cursorShape: Qt.PointingHandCursor\n                onClicked: {\n                    strip.tasksActivated()\n                    strip.activityVisible ? activityPopover.open() : activityPopover.close()\n                }\n            }\n        }\n    }\n\n    Popup {\n        id: activityPopover\n        objectName: \"statusActivityPopover\"\n        parent: strip\n        y: -height - Theme.space1\n        x: Math.max(Theme.space1, strip.width - width - Theme.space3)\n        width: 240\n        padding: Theme.space2\n\n        background: Rectangle {\n            color: Theme.surface2\n            radius: Theme.radiusMenu\n            border.color: Theme.hairlineStrong\n            border.width: 1\n        }\n\n        contentItem: Column {\n            spacing: Theme.space1\n\n            Text {\n                text: qsTr(\"Background tasks\")\n                color: Theme.textHi\n                font.pixelSize: Theme.fontMeta\n                font.bold: true\n            }\n\n            Repeater {\n                model: strip.tasks\n\n                delegate: RowLayout {\n                    objectName: \"statusTaskRow\"\n                    required property var modelData\n                    width: activityPopover.width - 2 * Theme.space2\n                    spacing: Theme.space2\n\n                    Text {\n                        objectName: \"statusTaskLabel\"\n                        text: modelData.label === undefined ? \"\" : modelData.label\n                        color: Theme.textMid\n                        font.pixelSize: Theme.fontMeta\n                        Layout.fillWidth: true\n                        elide: Text.ElideRight\n                    }\n\n                    Text {\n                        objectName: \"statusTaskCount\"\n                        text: modelData.count === undefined ? \"\" : (\"\" + modelData.count)\n                        color: Theme.textLow\n                        font.pixelSize: Theme.fontMeta\n                    }\n                }\n            }\n        }\n    }\n}", "path": "/home/treshen/Projects/QG/qml/QG/strips/StatusStrip.qml"}, "timestamp": 1791453512957}
