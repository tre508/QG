{"type": "tool_use", "name": "write_file", "input": {"content": "// StatusStrip tests (Prompt 22).\n//\n// Verifies the strip is presentation-only: it renders the selection summary,\n// volume free space, background-activity cluster + task list, and transient\n// status purely from injected properties.\n\nimport QtQuick\nimport QtQuick.Controls\nimport QtTest\nimport qg\n\nTestCase {\n    name: \"StatusStrip\"\n    when: windowShown\n\n    Component { id: stripComponent; StatusStrip {} }\n\n    function makeStrip(props) {\n        const base = {\n            width: 1200,\n            selectedCount: 3,\n            selectedBytes: 4509715661, // ~4.2 GB\n            volumeLabel: \"SSD\",\n            volumeFreeBytes: 236223201280, // ~220 GB\n            busyCount: 3,\n            tasks: [\n                { label: \"Thumbnails\", count: 12 },\n                { label: \"Probing\", count: 5 },\n                { label: \"Trash\", count: 2 }\n            ],\n            transientMessage: \"\",\n            transientKind: 0\n        }\n        return createTemporaryObject(stripComponent, null, Object.assign({}, base, props || {}))\n    }\n\n    function findByName(item, name) {\n        if (!item) return null\n        if (item.objectName === name) return item\n        const kids = item.children\n        if (!kids) return null\n        for (let i = 0; i < kids.length; ++i) {\n            const found = findByName(kids[i], name)\n            if (found) return found\n        }\n        return null\n    }\n\n    function test_selectionSummaryFromFixture() {\n        const strip = makeStrip()\n        compare(strip.hasSelection, true)\n        compare(findByName(strip, \"statusSelection\").text, \"3 selected \\u00B7 4.2 GB\")\n    }\n\n    function test_noSelectionPlaceholder() {\n        const strip = makeStrip({ selectedCount: 0, selectedBytes: 0 })\n        compare(strip.hasSelection, false)\n        compare(findByName(strip, \"statusSelection\").text, \"No selection\")\n    }\n\n    function test_freeSpaceKnown() {\n        const strip = makeStrip()\n        compare(strip.freeSpaceKnown, true)\n        const free = findByName(strip, \"statusFreeSpace\")\n        compare(free.visible, true)\n        compare(free.text, \"Free 220 GB on SSD\")\n    }\n\n    function test_freeSpaceUnknownIsNotFabricated() {\n        const strip = makeStrip({ volumeFreeBytes: -1, volumeLabel: \"\" })\n        compare(strip.freeSpaceKnown, false)\n        compare(findByName(strip, \"statusFreeSpace\").visible, false)\n        compare(findByName(strip, \"statusFreeSpace\").text, \"\")\n    }\n\n    function test_activityCountRenders() {\n        const strip = makeStrip()\n        const activity = findByName(strip, \"statusActivity\")\n        compare(activity.visible, true)\n        compare(findByName(strip, \"statusActivityCount\").text, \"3 background tasks\")\n        compare(findByName(strip, \"activityDots\").children.length >= 3, true)\n    }\n\n    function test_activitySingularAndHiddenWhenIdle() {\n        let strip = makeStrip({ busyCount: 1 })\n        compare(findByName(strip, \"statusActivityCount\").text, \"1 background task\")\n\n        strip = makeStrip({ busyCount: 0 })\n        compare(findByName(strip, \"statusActivity\").visible, false)\n    }\n\n    function test_activityPopoverListsTasks() {\n        const strip = makeStrip()\n        const popover = findByName(strip, \"statusActivityPopover\")\n        compare(popover.visible, false)\n\n        const activity = findByName(strip, \"statusActivity\")\n        mouseClick(activity, activity.width / 2, activity.height / 2)\n        tryCompare(popover, \"visible\", true)\n\n        const rows = []\n        const collect = function (item) {\n            if (!item) return\n            if (item.objectName === \"statusTaskRow\") rows.push(item)\n            const kids = item.children\n            if (kids) for (let i = 0; i < kids.length; ++i) collect(kids[i])\n        }\n        collect(popover.contentItem)\n        compare(rows.length, 3)\n        compare(findByName(popover.contentItem, \"statusTaskLabel\").text, \"Thumbnails\")\n        compare(findByName(popover.contentItem, \"statusTaskCount\").text, \"12\")\n    }\n\n    function test_transientStatusArea() {\n        const strip = makeStrip({ transientMessage: \"Moved to Trash\", transientKind: 2 })\n        const transient = findByName(strip, \"statusTransient\")\n        compare(transient.visible, true)\n        compare(transient.text, \"Moved to Trash\")\n        compare(transient.color, Theme.danger)\n    }\n}", "path": "/home/treshen/Projects/QG/tests/qml/tst_statusstrip.qml"}, "timestamp": 1791453715694}
