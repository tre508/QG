{"type": "tool_result", "name": "read_file", "output": "{\"content\": \"1|#pragma once\\n2|\\n3|// Canonical ordered entry model (DESIGN.md §14.2, §15.2, §20.1).\\n4|//\\n5|// `FolderModel` holds folders + videos in a single, ordered list and is the one\\n6|// authoritative entry source: the ContentView, the Reel and the PlaybackContext\\n7|// all derive from it. Rows are compact value structs; heavy per-row data\\n8|// (decoded thumbnails, probe results) is attached lazily by targeted role\\n9|// updates. Workers must never mutate the model directly — results are applied on\\n10|// the GUI thread only.\\n11|\\n12|#include \\\"core/types.hpp\\\"\\n13|\\n14|#include <QAbstractListModel>\\n15|#include <QHash>\\n16|#include <QList>\\n17|#include <QVariant>\\n18|\\n19|#include <functional>\\n20|\\n21|namespace qg {\\n22|\\n23|class FolderModel : public QAbstractListModel {\\n24|    Q_OBJECT\\n25|    Q_PROPERTY(int count READ count NOTIFY countChanged)\\n26|    Q_PROPERTY(int videoCount READ videoCount NOTIFY countChanged)\\n27|    Q_PROPERTY(int folderCount READ folderCount NOTIFY countChanged)\\n28|\\n29|public:\\n30|    enum Roles {\\n31|        IdentityRole = Qt::UserRole + 1,\\n32|        PathRole,\\n33|        NameRole,\\n34|        KindRole,\\n35|        IsFolderRole,\\n36|        IsVideoRole,\\n37|        ThumbnailRole,\\n38|        ThumbnailStateRole,\\n39|        DurationRole,\\n40|        SizeRole,\\n41|        MtimeRole,\\n42|        FavoriteRole,\\n43|        WatchedRole,\\n44|        ProgressRole,\\n45|        WidthRole,\\n46|        HeightRole,\\n47|    };\\n48|    Q_ENUM(Roles)\\n49|\\n50|    explicit FolderModel(QObject *parent = nullptr);\\n51|\\n52|    int rowCount(const QModelIndex &parent = QModelIndex()) const override;\\n53|    QVariant data(const QModelIndex &index, int role) const override;\\n54|    QHash<int, QByteArray> roleNames() const override;\\n55|\\n56|    // Replace all rows (model reset).\\n57|    void applySnapshot(const FolderSnapshot &snapshot);\\n58|\\n59|    // Append one enumeration batch (minimal rowsInserted).\\n60|    void applyBatch(const FolderSnapshot &batch);\\n61|\\n62|    // Apply an identity-based diff (external change): minimal rowsRemoved /\\n63|    // dataChanged / rowsInserted, preserving unaffected rows and ordering.\\n64|    void applyDiff(const FolderDiff &diff);\\n65|\\n66|    void clear();\\n67|\\n68|    // Targeted role updates (identity-keyed). No-op when unknown.\\n69|    void updateThumbnail(const QString &identity, const QVariant &image, ThumbnailState state);\\n70|    void updateProbe(const QString &identity,\\n71|                     const std::optional<qint64> &durationMs,\\n72|                     const std::optional<int> &width,\\n73|                     const std::optional<int> &height);\\n74|    void updateState(const QString &identity,\\n75|                     const std::optional<bool> &favorite,\\n76|                     const std::optional<bool> &watched,\\n77|                     const std::optional<double> &progress);\\n78|\\n79|    bool removeByIdentity(const QString &identity);\\n80|\\n81|    int indexOfIdentity(const QString &identity) const;\\n82|    const Entry *entryAt(int row) const;\\n83|    QList<Entry> entries() const;\\n84|    int count() const { return static_cast<int>(m_entries.size()); }\\n85|    int videoCount() const noexcept { return m_videoCount; }\\n86|    int folderCount() const noexcept { return m_folderCount; }\\n87|\\n88|    // QML-facing row access (used by the view for keyboard activation).\\n89|    Q_INVOKABLE QString pathAt(int row) const;\\n90|    Q_INVOKABLE QString nameAt(int row) const;\\n91|    Q_INVOKABLE bool isFolderAt(int row) const;\\n92|\\n93|    // Projection hook for the Reel / PlaybackContext (videos only, in order).\\n94|    QList<Entry> entriesMatching(const std::function<bool(const Entry &)> &predicate) const;\\n95|\\n96|signals:\\n97|    void countChanged();\\n98|\\n99|private:\\n100|    void recount();\\n101| 