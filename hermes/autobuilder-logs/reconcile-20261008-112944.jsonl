\n57|add_executable(qg_workers_test\\n58|    unit/test_workers.cpp\\n59|)\\n60|set_target_properties(qg_workers_test PROPERTIES AUTOMOC ON)\\n61|target_link_libraries(qg_workers_test PRIVATE\\n62|    qg_core\\n63|    Qt6::Test\\n64|    qg_warnings\\n65|)\\n66|add_test(NAME qg_workers COMMAND qg_workers_test)\\n67|\\n68|# --- Core domain types, errors, identity, events (Prompt 05) -----------------\\n69|add_executable(qg_core_test\\n70|    unit/test_core.cpp\\n71|)\\n72|set_target_properties(qg_core_test PROPERTIES AUTOMOC ON)\\n73|target_link_libraries(qg_core_test PRIVATE\\n74|    qg_core\\n75|    Qt6::Test\\n76|    qg_warnings\\n77|)\\n78|add_test(NAME qg_core COMMAND qg_core_test)\\n79|\\n80|# --- SQLite persistence foundation (Prompt 06) -------------------------------\\n81|add_executable(qg_persistence_test\\n82|    unit/test_persistence.cpp\\n83|)\\n84|set_target_properties(qg_persistence_test PROPERTIES AUTOMOC ON)\\n85|target_link_libraries(qg_persistence_test PRIVATE\\n86|    qg_core\\n87|    Qt6::Test\\n88|    qg_warnings\\n89|)\\n90|add_test(NAME qg_persistence COMMAND qg_persistence_test)\\n91|\\n92|# --- Media format registry (Prompt 07) ---------------------------------------\\n93|add_executable(qg_formats_test\\n94|    unit/test_formats.cpp\\n95|)\\n96|set_target_properties(qg_formats_test PROPERTIES AUTOMOC ON)\\n97|target_link_libraries(qg_formats_test PRIVATE\\n98|    qg_core\\n99|    Qt6::Test\\n100|    qg_warnings\\n101|)\\n102|add_test(NAME qg_formats COMMAND qg_formats_test)\\n103|\\n104|# --- Path helpers + filename validation (Prompt 08) --------------------------\\n105|add_executable(qg_paths_test\\n106|    unit/test_paths.cpp\\n107|)\\n108|set_target_properties(qg_paths_test PROPERTIES AUTOMOC ON)\\n109|target_link_libraries(qg_paths_test PRIVATE\\n110|    qg_core\\n111|    Qt6::Test\\n112|    qg_warnings\\n113|)\\n114|add_test(NAME qg_paths COMMAND qg_paths_test)\\n115|\\n116|# --- Filesystem enumerator (Prompt 09) ------------------------