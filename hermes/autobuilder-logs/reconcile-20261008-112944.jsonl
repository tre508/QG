{"type": "tool_result", "name": "read_file", "output": "{\"content\": \"1|#pragma once\\n2|\\n3|// Directory watching and identity-based diffing (DESIGN.md §17.5).\\n4|//\\n5|// `DirectoryWatcher` watches the current directory (and its parent, so it can\\n6|// re-arm when the directory is replaced), debounces bursts to a single\\n7|// `changed(path)` after 300 ms, and exposes an immediate refresh request.\\n8|// `computeFolderDiff` turns a fresh enumeration into the minimal set of\\n9|// identity-based updates, so the view applies `rowsInserted`/`rowsRemoved`/\\n10|// `dataChanged` instead of a full reload.\\n11|\\n12|#include \\\"core/types.hpp\\\"\\n13|\\n14|#include <QFileSystemWatcher>\\n15|#include <QObject>\\n16|#include <QString>\\n17|#include <QTimer>\\n18|\\n19|namespace qg {\\n20|\\n21|class DirectoryWatcher : public QObject {\\n22|    Q_OBJECT\\n23|\\n24|public:\\n25|    explicit DirectoryWatcher(QObject *parent = nullptr);\\n26|\\n27|    void setPath(const QString &directory);\\n28|    void clear();\\n29|    QString path() const { return m_directory; }\\n30|\\n31|    void setDebounceInterval(int msec) { m_debounce.setInterval(msec); }\\n32|\\n33|public slots:\\n34|    void forceRefresh();\\n35|\\n36|signals:\\n37|    void changed(const QString &directory);\\n38|    void refreshRequested(const QString &directory);\\n39|\\n40|private:\\n41|    void onDirectoryChanged();\\n42|    void onDebounceElapsed();\\n43|    void reArm();\\n44|\\n45|    QFileSystemWatcher m_watcher;\\n46|    QTimer m_debounce;\\n47|    QString m_directory;\\n48|};\\n49|\\n50|// Difference from `current` rows to `next` enumeration, keyed by identity.\\n51|FolderDiff computeFolderDiff(const QList<Entry> &current, const QList<Entry> &next);\\n52|\\n53|} // namespace qg\", \"total_lines\": 53, \"file_size\": 1447, \"truncated\": false, \"is_binary\": false, \"is_image\": false, \"not_found\": false}", "duration_ms": 7, "is_error": false, "timestamp": 1791451879001}
