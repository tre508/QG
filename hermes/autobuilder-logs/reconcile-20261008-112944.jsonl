{"type": "tool_result", "name": "read_file", "output": "{\"content\": \"1|#pragma once\\n2|\\n3|// QG media identity (DESIGN.md §17.8, §21.4).\\n4|//\\n5|// Identity keeps application state (favorite, watched, position, costs) attached\\n6|// to a file across renames within a filesystem. The primary key is the inode\\n7|// `(st_dev, st_ino)`. Where a filesystem does not provide a stable inode, a\\n8|// lazily computed fingerprint `(size, mtime_ns, first-64KiB hash)` is used, and\\n9|// only as a last resort is a path-only key produced (degradation is explicit,\\n10|// never silent).\\n11|\\n12|#include \\\"core/errors.hpp\\\"\\n13|\\n14|#include <QByteArray>\\n15|#include <QString>\\n16|\\n17|#include <cstdint>\\n18|\\n19|namespace qg {\\n20|\\n21|enum class IdentityKind {\\n22|    Inode,       // stable (st_dev, st_ino)\\n23|    Fingerprint, // (size, mtime_ns, first-64KiB hash)\\n24|    PathOnly,    // degraded: no stable identity available\\n25|};\\n26|\\n27|struct FileIdentity {\\n28|    QString key;\\n29|    IdentityKind kind = IdentityKind::Inode;\\n30|\\n31|    bool isValid() const noexcept { return !key.isEmpty(); }\\n32|\\n33|    friend bool operator==(const FileIdentity &, const FileIdentity &) = default;\\n34|};\\n35|\\n36|// Deterministic string encodings (used as SQLite keys).\\n37|QString encodeInodeIdentity(std::uint64_t device, std::uint64_t inode);\\n38|QString encodeFingerprintIdentity(qint64 size, qint64 mtimeNs, const QByteArray &hash);\\n39|QString encodePathIdentity(const QString &absolutePath);\\n40|\\n41|// Identity from already-collected `stat` data. Callers must only use this when\\n42|// `inode` is non-zero; otherwise use fingerprintIdentity().\\n43|FileIdentity identityFromStat(std::uint64_t device,\\n44|                              std::uint64_t inode);\\n45|\\n46|// Lazily computed fingerprint fallback. Reads at most 64 KiB.\\n47|Result<FileIdentity> fingerprintIdentity(const QString &path, qint64 size, qint64 mtimeNs);\\n48|\\n49|// Full resolution for a path: stat -> inode, else fingerprint, else path-only.\\n50|Result<FileIdentity> identityFromPath(const QString &path);\\n51|\\n52|} // namespace qg\", \"total_lines\": 52, \"file_size\": 1845, \"truncated\": false, \"is_binary\": false, \"is_image\": false, \"not_found\": false}", "duration_ms": 5, "is_error": false, "timestamp": 1791451873243}
