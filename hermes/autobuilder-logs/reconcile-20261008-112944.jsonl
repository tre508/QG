{"type": "tool_result", "name": "read_file", "output": "{\"content\": \"1|// QG entry point (DESIGN.md 15.1, 23.1).\\n2|//\\n3|// Responsibilities are deliberately minimal: create the QGuiApplication, force\\n4|// the Qt Quick OpenGL scene-graph backend BEFORE any QQuickWindow exists, then\\n5|// hand control to App. Business logic lives in App and its services.\\n6|\\n7|#include <QGuiApplication>\\n8|#include <QQuickWindow>\\n9|#include <QSGRendererInterface>\\n10|\\n11|#include \\\"app.hpp\\\"\\n12|\\n13|int main(int argc, char *argv[])\\n14|{\\n15|    QGuiApplication app(argc, argv);\\n16|    QGuiApplication::setApplicationName(QStringLiteral(\\\"QG\\\"));\\n17|    QGuiApplication::setApplicationDisplayName(QStringLiteral(\\\"QG\\\"));\\n18|    QGuiApplication::setOrganizationName(QStringLiteral(\\\"QGayze\\\"));\\n19|    QGuiApplication::setApplicationVersion(QStringLiteral(\\\"0.1.0\\\"));\\n20|\\n21|    // libmpv's Render API and the Qt Quick scene graph must share one OpenGL\\n22|    // pipeline (DEC-006). This must be set before the first QQuickWindow.\\n23|    QQuickWindow::setGraphicsApi(QSGRendererInterface::OpenGL);\\n24|\\n25|    qg::App qgApp;\\n26|    if (!qgApp.initialize()) {\\n27|        return 1;\\n28|    }\\n29|    return qgApp.exec();\\n30|}\", \"total_lines\": 30, \"file_size\": 1042, \"truncated\": false, \"is_binary\": false, \"is_image\": false, \"not_found\": false}", "duration_ms": 7, "is_error": false, "timestamp": 1791452320877}
{"type": "tool_result", "name": "read_file", "output": "{\"content\": \"1|#pragma once\\n2|\\n3|// QG application object: the ownership root for startup/shutdown and the C++\\n4|// services, models and controllers wired into QML (DESIGN.md §15.1, §23.1).\\n5|\\n6|#include <memory>\\n7|\\n8|#include \\\"config.hpp\\\"\\n9|\\n10|class QQmlApplicationEngine;\\n11|\\n12|namespace qg {\\n13|\\n14|class BrowserController;\\n15|class Database;\\n16|class MountService;\\n17|class PlacesModel;\\n18|class RecentRepository;\\n19|\\n20|class App {\\n21|public:\\n22|    App();\\n23|    ~App();\\n24|\\n25|    App(const App &) = delete;\\n26|    App &operator=(const App &) = delete;\\n27|\\n28|    // Resolve configuration, create directories, initialize logging, open the\\n29|    // database, build the browser/places/mount services, load the QML shell and\\n30|    // inject the controllers into it. Returns false (with a logged error) if\\n31|    // startup fails.\\n32|    bool initialize();\\n33|\\n34|    // Enter the Qt event loop. Call only after a successful initialize().\\n35|    int exec();\\n36|\\n37|    const Config &config() const { return m_config; }\\n38|\\n39|private:\\n40|    Config m_config;\\n41|\\n42|    // Declared before m_engine so the engine (and therefore QML, which holds\\n43|    // pointers to the controllers) is destroyed first.\\n44|    std::unique_ptr<Database> m_database;\\n45|    std::unique_ptr<RecentRepository> m_recent;\\n46|    std::unique_ptr<BrowserController> m_browser;\\n47|    std::unique_ptr<PlacesModel> m_places;\\n48|    std::unique_ptr<MountService> m_mounts;\\n49|    std::unique_ptr<QQmlApplicationEngine> m_engine;\\n50|\\n51|    bool m_initialized = false;\\n52|};\\n53|\\n54|} // namespace qg\", \"total_lines\": 54, \"file_size\": 1414, \"truncated\": false, \"is_binary\": false, \"is_image\": false, \"not_found\": false}", "duration_ms": 7, "is_error": false, "timestamp": 1791452320879}
